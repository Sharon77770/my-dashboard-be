# Required: enter your own single account credentials. No default account is provided.
DASHBOARD_AUTH_ID=
DASHBOARD_AUTH_PASSWORD=
# Optional external MCP bearer token (at least 32 characters); the embedded Codex uses an ephemeral token if empty.
DASHBOARD_MCP_TOKEN=
DASHBOARD_PORT=8080
# 127.0.0.1 for a host HTTPS proxy; 0.0.0.0 for direct server-IP access.
DASHBOARD_BIND_ADDRESS=127.0.0.1
# true for HTTPS deployment; false only for local HTTP development.
SESSION_COOKIE_SECURE=true
SESSION_TIMEOUT=30m
UPLOAD_MAX_SIZE=1GB

# Cloud workspace: 0 means no container CPU/memory ceiling (host/VM limits still apply).
# Example for a sufficiently sized server: WORKSPACE_CPUS=8, WORKSPACE_MEMORY_LIMIT=16g.
WORKSPACE_CPUS=0
WORKSPACE_MEMORY_LIMIT=0
WORKSPACE_SHM_SIZE=256m
BROWSER_SHM_SIZE=1gb
# Dashboard JVM only; leave memory for builds, terminals and project processes.
DASHBOARD_JAVA_TOOL_OPTIONS=-Xms128m -Xmx1g
# Optional extra Ubuntu apt package names. Requires an image rebuild; never put secrets here.
WORKSPACE_APT_PACKAGES=

# Tailscale is included by docker compose up -d --build.
# Start login in Tailscale settings, then open the displayed URL on your own device.
TAILSCALE_HOSTNAME=personal-dashboard
TAILSCALE_ACCEPT_DNS=true
# Enable only when you intend to use approved subnet routes in your tailnet.
TAILSCALE_ACCEPT_ROUTES=false

# Private cloud drive path inside the container; keep it under the persistent /app/data volume.
CLOUD_ROOT=/app/data/cloud

# SMB3 NAS credentials are separate from the dashboard account. Keep the real .env private.
NAS_USERNAME=
NAS_PASSWORD=
# Bind SMB only to a trusted LAN/VPN interface address on the Linux host, never a public interface.
NAS_SMB_BIND_ADDRESS=
# Optional host port override for local Docker Desktop testing when Windows owns TCP 445.
# Keep 445 for normal SMB clients on a dedicated LAN/VPN server.
NAS_SMB_HOST_PORT=445
# Hostname or address clients use to reach the SMB server (can be a LAN/VPN DNS name).
NAS_SMB_HOST=
